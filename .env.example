# ---------------------------------------------------------------------------
# Contact form delivery (optional)
#
# The contact form posts to /api/contact. Until one of the options below is
# configured the API responds with "not_configured" and the form offers an
# email fallback instead of reporting a false success.
# ---------------------------------------------------------------------------

# Option A — forward submissions to any endpoint that accepts JSON
# CONTACT_WEBHOOK_URL="https://example.com/hooks/shellman-contact"

# Option B — send email through Resend
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# CONTACT_TO_EMAIL="support@ShellmanTech.com"
# CONTACT_FROM_EMAIL="Shellman Tech <hello@shellmantech.com>"

# ---------------------------------------------------------------------------
# Spam protection (optional) — Cloudflare Turnstile
#
# Both keys come from the Cloudflare dashboard (Turnstile → Add widget). With
# the secret unset the check is skipped. Cloudflare's always-pass test keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# ---------------------------------------------------------------------------
# Admin area (/admin) — all optional; the admin shows what isn't connected yet
# ---------------------------------------------------------------------------
# Sign-in. Keep these out of the repo — set them in Vercel only.
# ADMIN_USERNAME="..."
# ADMIN_PASSWORD="..."
# Optional: sign sessions with a separate secret (otherwise derived from the above)
# ADMIN_SESSION_SECRET="long-random-string"

# Postgres that stores the synced inbox (Vercel → Storage → Neon adds this)
# DATABASE_URL="postgres://..."

# The support@ mailbox, read over IMAP (read-only)
# IMAP_HOST="imap.secureserver.net"   # GoDaddy; Titan is imap.titan.email
# IMAP_PORT="993"
# IMAP_USER="support@shailmanntech.com"
# IMAP_PASSWORD="..."

# Automated mail (service notices, newsletters, no-reply senders) is filed in
# an "Automated" folder. Comma-separated addresses or domains to override it:
# ADMIN_IGNORE_SENDERS="example-newsletter.com,alerts@bank.example"
# ADMIN_ALLOW_SENDERS="bigclient.com"

# OpenAI for analysing emails, drafting replies and answering inbox questions
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.5"   # optional

# ---------------------------------------------------------------------------
# Book a call — a Cal.com (or any https) link. Shows "Book a call" buttons on
# the site and lets the AI's good-fit replies invite clients to book.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_BOOKING_URL="https://cal.com/your-name/intro"

# ---------------------------------------------------------------------------
# Lead alerts on Telegram. Create a bot with @BotFather for the token; the
# admin's System page finds your chat ID. TELEGRAM_ALERT_ON lists which AI
# verdicts alert you: yes, info, other, no, spam or all (default: yes).
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_CHAT_ID="123456789"
# TELEGRAM_ALERT_ON="yes"

# Protects the scheduled mail check (/api/cron/check-mail). Set the same value
# as a GitHub repository secret named CRON_SECRET; .github/workflows/check-mail.yml
# then checks for new mail every 10 minutes.
# CRON_SECRET="a-long-random-string"

# ---------------------------------------------------------------------------
# Client portal — "Continue with Google". Create an OAuth client (type: Web
# application) in Google Cloud Console → APIs & Services → Credentials, with
# these authorised redirect URIs:
#   https://shailmanntech.com/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback   (for local testing)
# Without these, the portal offers email + password only.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
